# Rider Service — port 5005
# Copy to .env and fill in real values. Never commit .env.

# Server
PORT=5005

# MongoDB (database name riderDB is set in code)
MONGO_URI=mongodb://localhost:27017

# JWT signing secret — must match Auth, Store, Admin, and Realtime services
JWT_SEC=your-super-secret-jwt-key-change-me

# RabbitMQ
RABBITMQ_URL=amqp://localhost:5672
ORDER_READY_QUEUE=order_ready_queue
RIDER_QUEUE=rider_queue

# Downstream service URLs (local development)
STORE_SERVICE=http://localhost:5001
REALTIME_SERVICE=http://localhost:5004
UTILS_SERVICE=http://localhost:5002

# Shared secret for service-to-service HTTP calls (x-internal-key header)
INTERNAL_SERVICE_KEY=your-internal-service-key-change-me

# Realtime Service (Socket.IO) — port 5004
# Copy to .env and fill in real values. Never commit .env.

# Server
PORT=5004

# JWT signing secret — must match Auth, Store, Rider, and Admin services
JWT_SEC=your-super-secret-jwt-key-change-me

# Shared secret for internal emit endpoint (x-internal-key header)
# Must match Store, Rider, Utils, and Admin services
INTERNAL_SERVICE_KEY=your-internal-service-key-change-me

# Admin Service — port 5006
# Copy to .env and fill in real values. Never commit .env.

# Server
PORT=5006

# MongoDB connection used by the native driver
# Default database in the URI is used for collections (stores, riders).
# Stores are in storeDB; riders are in riderDB — use the DB that contains
# the collection you need, or a shared deployment where both are accessible.
MONGO_URI=mongodb://localhost:27017/storeDB

# JWT signing secret — must match Auth and other services
# Admin users must have role "admin" in their JWT payload
JWT_SEC=your-super-secret-jwt-key-change-me

# Shared secret (if calling internal endpoints from admin in future)
INTERNAL_SERVICE_KEY=your-internal-service-key-change-me

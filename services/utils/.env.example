# Utils Service — port 5002
# Copy to .env and fill in real values. Never commit .env.

# Server
PORT=5002

# Cloudinary (image uploads)
# https://cloudinary.com/console
CLOUD_NAME=your-cloud-name
CLOUD_API_KEY=your-cloud-api-key
CLOUD_SECRET_KEY=your-cloud-secret-key

# Razorpay (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_xxxxxxxx

# RabbitMQ
RABBITMQ_URL=amqp://localhost:5672
PAYMENT_QUEUE=payment_queue

# Store service URL (fetch order details for payment)
STORE_SERVICE=http://localhost:5001

# Shared secret for service-to-service HTTP calls (x-internal-key header)
INTERNAL_SERVICE_KEY=your-internal-service-key-change-me

# Frontend URL (Stripe redirect URLs after checkout)
FRONTEND_URL=http://localhost:5173

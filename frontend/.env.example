# Frontend (Vite) — port 5173
# Copy to .env and fill in real values. Never commit .env.
# Only variables prefixed with VITE_ are exposed to the browser.

# Google OAuth client ID (same app as Auth service GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Stripe publishable key (pair with STRIPE_SECRET_KEY in utils service)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx

# Internal service key — used by RiderOrderMap to emit live location via Realtime
# Must match INTERNAL_SERVICE_KEY across backend services
VITE_INTERNAL_SERVICE_KEY=your-internal-service-key-change-me

# Optional: override API base URLs (defaults are hardcoded in src/main.tsx for localhost)
# VITE_AUTH_SERVICE=http://localhost:5000
# VITE_STORE_SERVICE=http://localhost:5001
# VITE_UTILS_SERVICE=http://localhost:5002
# VITE_REALTIME_SERVICE=http://localhost:5004
# VITE_RIDER_SERVICE=http://localhost:5005
# VITE_ADMIN_SERVICE=http://localhost:5006

# Auth Service — port 5000
# Copy to .env and fill in real values. Never commit .env.

# Server
PORT=5000

# MongoDB (database name authDB is set in code)
MONGO_URI=mongodb://localhost:27017

# JWT signing secret — must match Store, Rider, Admin, and Realtime services
JWT_SEC=your-super-secret-jwt-key-change-me

# Google OAuth 2.0 (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
